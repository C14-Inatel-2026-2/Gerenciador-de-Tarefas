pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        CI = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm ci || npm install'
                        } else {
                            bat 'npm ci || npm install'
                        }
                    }
                }
            }
        }

        stage('Run Tests & Coverage') {
            steps {
                dir('frontend') {
                    dir('reports') { deleteDir() }
                    dir('coverage') { deleteDir() }
                    script {
                        if (isUnix()) {
                            sh 'npm run test:ci'
                        } else {
                            bat 'npm run test:ci'
                        }
                    }
                }
            }
        }

        stage('Typecheck & Build') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm run build'
                        } else {
                            bat 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'frontend/dist/**', allowEmptyArchive: false, fingerprint: true
            }
        }

        stage('Deploy Frontend') {
            when {
                expression {
                    !env.CHANGE_ID && (env.BRANCH_NAME ?: env.GIT_BRANCH) in ['main', 'origin/main']
                }
            }
            steps {
                withCredentials([string(credentialsId: 'render-frontend-deploy-hook', variable: 'RENDER_DEPLOY_HOOK_URL')]) {
                    script {
                        if (isUnix()) {
                            sh '''
                                set +x
                                curl --fail --silent --show-error --max-time 60 --request POST "$RENDER_DEPLOY_HOOK_URL&ref=$GIT_COMMIT"
                            '''
                        } else {
                            bat '''
                                @echo off
                                curl.exe --fail --silent --show-error --max-time 60 --request POST "%RENDER_DEPLOY_HOOK_URL%&ref=%GIT_COMMIT%"
                            '''
                        }
                    }
                }
                echo 'Deploy solicitado ao Render. Acompanhe a conclusao no painel do servico.'
            }
        }
    }

    post {
        always {
            junit testResults: 'frontend/reports/junit.xml', allowEmptyResults: true
            publishHTML(target: [
                reportDir: 'frontend/coverage',
                reportFiles: 'index.html',
                reportName: 'Cobertura do frontend',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
        }
        success {
            echo 'Build do frontend concluido com sucesso.'
        }
        failure {
            echo 'Falha no build do frontend.'
        }
    }
}
