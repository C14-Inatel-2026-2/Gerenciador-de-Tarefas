pipeline {
    agent any

    environment {
        CI = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm ci || npm install'
                        } else {
                            bat 'npm ci || npm install'
                        }
                    }
                }
            }
        }

        stage('Run Tests & Coverage') {
            steps {
                dir('frontend') {
                    dir('reports') { deleteDir() }
                    dir('coverage') { deleteDir() }
                    script {
                        if (isUnix()) {
                            sh 'npm run test:ci'
                        } else {
                            bat 'npm run test:ci'
                        }
                    }
                }
            }
        }

        stage('Typecheck & Build') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm run build'
                        } else {
                            bat 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'frontend/dist/**', allowEmptyArchive: false, fingerprint: true
            }
        }
    }

    post {
        always {
            junit testResults: 'frontend/reports/junit.xml', allowEmptyResults: true
            publishHTML(target: [
                reportDir: 'frontend/coverage',
                reportFiles: 'index.html',
                reportName: 'Cobertura do frontend',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
        }
        success {
            echo 'Build do frontend concluido com sucesso.'
        }
        failure {
            echo 'Falha no build do frontend.'
        }
    }
}
