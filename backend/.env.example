# Copie este arquivo para ".env" e preencha com os valores reais do projeto no Supabase.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

# Connection string do Postgres do Supabase.
# Encontre em: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[ID-DO-PROJETO].supabase.co:5432/postgres

# Dados da API do Supabase (usados se formos integrar a autenticação).
# Encontre em: Project Settings > API
SUPABASE_URL=https://[ID-DO-PROJETO].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
